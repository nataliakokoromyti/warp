+def _scratch_array(d, key: str, shape, dtype):
+  """Return a per-Data cached scratch array, allocating on first use.
+
+  Temporary arrays allocated inside step() become memAlloc/memFree nodes in
+  captured graphs (mempool allocations), which replay slowly on some platforms.
+  Caching them on Data keeps captured step graphs kernel-only. Arrays are
+  reallocated if the requested shape changes; contents persist between calls.
+  """
+  cache = getattr(d, "_scratch_arrays", None)
+  if cache is None:
+    cache = {}
+    d._scratch_arrays = cache
+  if not isinstance(shape, tuple):
+    shape = (shape,)
+  arr = cache.get(key)
+  if arr is None or arr.shape != shape:
+    arr = wp.empty(shape, dtype=dtype)
+    cache[key] = arr
+  return arr
+
+
+def scratch_empty(d, key: str, shape, dtype):
+  """Cached equivalent of ``wp.empty``: contents are uninitialized."""
+  return _scratch_array(d, key, shape, dtype)
+
+
+def scratch_zeros(d, key: str, shape, dtype):
+  """Cached equivalent of ``wp.zeros``: zeroed on every call."""
+  arr = _scratch_array(d, key, shape, dtype)
+  arr.zero_()
+  return arr
+
+
+def scratch_full(d, key: str, shape, dtype, value):
+  """Cached equivalent of ``wp.full``: filled with ``value`` on every call."""
+  arr = _scratch_array(d, key, shape, dtype)
+  arr.fill_(value)
+  return arr
+
