+def _cached_solver_context(m: types.Model, d: types.Data) -> SolverContext:
+  """Reuse the solver context across solves on the same Data.
+
+  Allocating the context on every solve puts memAlloc/memFree nodes into
+  captured graphs. Buffers that _create_solver_context allocates with zeros
+  are re-zeroed on reuse; the rest are workspace and need no initialization.
+  """
+  key = (m.nv, m.nv_pad, d.njmax, int(m.opt.solver), _use_incremental(m))
+  cached = getattr(d, "_solver_ctx_cache", None)
+  if cached is None or cached[0] != key:
+    ctx = _create_solver_context(m, d)
+    d._solver_ctx_cache = (key, ctx)
+    return ctx
+  ctx = cached[1]
+  ctx.grad.zero_()
+  ctx.ls_exhausted.zero_()
+  return ctx
+
