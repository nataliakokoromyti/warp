+def share_scratch(src, dst):
+  """Point ``dst`` at ``src``'s scratch cache.
+
+  Used where a shallow ``dataclasses.replace`` copy of Data is rebuilt every step (the
+  compact solve): the copy would otherwise start with an empty cache and reallocate its
+  scratch on every call.
+  """
+  cache = getattr(src, "_scratch_arrays", None)
+  if cache is None:
+    cache = {}
+    src._scratch_arrays = cache
+  dst._scratch_arrays = cache
+  return dst
+
+
+def scratch_snapshot(d) -> dict:
+  """Snapshot the identity of every cached scratch array on ``d``.
+
+  Comparing snapshots taken around a graph capture tells whether the capture allocated
+  scratch. Anything allocated inside a capture is a graph allocation: it is only valid
+  while that graph runs, so it must not be read from the host or shared with another
+  graph.
+  """
+  cache = getattr(d, "_scratch_arrays", None) or {}
+  return {k: (v.ptr, v.shape) for k, v in cache.items()}
+
+
 def check_toolkit_driver():
