+# ==============================================================================
+"""Tests for the host-driven solver stepper."""
+
+import dataclasses
+
+import mujoco
+import numpy as np
+import warp as wp
+from absl.testing import absltest
+from absl.testing import parameterized
+
+import mujoco_warp as mjw
+from mujoco_warp import test_data
+
+# Trajectories are compared between two runs of the same kernels on the same device, so
+# they agree to well within physics tolerances; the slack is for the reduction-order
+# nondeterminism mujoco_warp has on its own (atomics in the constraint assembly), which
+# two plain mjw.step runs show just as much of as the stepper does. _RTOL bounds it
+# relative to the magnitude of the quantity being compared.
+_TOL = 1e-5
+_RTOL = 1e-3
+
+_STATE = ("qpos", "qvel", "qacc", "act", "qfrc_constraint", "sensordata")
+
+_NSTEP = 20
+
+
+def _state(d):
+  return {k: getattr(d, k).numpy().copy() for k in _STATE}
+
+
+def _unrolled(m):
+  """A copy of the model that unrolls the solver loop, as platforms without conditional
+  graph nodes do. Lets the split be exercised on any device."""
+  return dataclasses.replace(m, opt=dataclasses.replace(m.opt, graph_conditional=False))
+
+
+class StepperTest(parameterized.TestCase):
+  def setUp(self):
+    super().setUp()
+    if not wp.get_device().is_cuda:
+      self.skipTest("stepper requires a device with graph capture")
+
+  def _compare(self, mjm, nworld=8, chunk=None, split=True, **kwargs):
+    """Step three Datas from an identical state: two with mjw.step, one with a Stepper.
+
+    The two mjw.step runs are the control. mujoco_warp's constraint assembly uses atomics,
+    so trajectories diverge slightly run to run on their own; the stepper only has to stay
+    inside that spread, which is a much sharper claim than an absolute tolerance would be
+    on the platforms where the spread is wide.
+    """
+    mjd = mujoco.MjData(mjm)
+    mujoco.mj_forward(mjm, mjd)
+    m = _unrolled(mjw.put_model(mjm))
+    d_ref = mjw.put_data(mjm, mjd, nworld=nworld, **kwargs)
+    d_ctl = mjw.put_data(mjm, mjd, nworld=nworld, **kwargs)
+    d_run = mjw.put_data(mjm, mjd, nworld=nworld, **kwargs)
+
+    # identical warmup on all three so the trajectories start aligned; capture does not
+    # execute, so building the stepper leaves d_run's state untouched
+    for _ in range(3):
+      mjw.step(m, d_ref)
+      mjw.step(m, d_ctl)
+      mjw.step(m, d_run)
+    wp.synchronize_device()
+
+    stepper = mjw.Stepper(m, d_run, chunk=chunk, warmup=0, split=split)
+    for _ in range(_NSTEP):
+      mjw.step(m, d_ref)
+    for _ in range(_NSTEP):
+      mjw.step(m, d_ctl)
+    for _ in range(_NSTEP):
+      stepper.step()
+    wp.synchronize_device()
+
+    ref, ctl, run = _state(d_ref), _state(d_ctl), _state(d_run)
+    for key in _STATE:
+      if not ref[key].size:
+        continue
+      got = np.abs(run[key] - ref[key]).max()
+      control = np.abs(ctl[key] - ref[key]).max()
+      scale = np.abs(ref[key]).max()
+      # The control is one sample of a noisy quantity, so it alone would make the test
+      # flaky; the relative floor covers the case where the stepper happens to draw a
+      # wider sample than the control did. A split that actually skipped needed solver
+      # work shows up as an O(1) relative difference, far above either bound.
+      self.assertLessEqual(
+        got,
+        max(_TOL, 4 * control, _RTOL * scale),
+        f"mismatch: {key} (stepper {got:.3e}, mjw.step-to-mjw.step control {control:.3e}, scale {scale:.3e})",
+      )
+    return stepper, d_run
+
+  @parameterized.parameters("humanoid/humanoid.xml", "pendula.xml", "constraints.xml")
+  def test_matches_step(self, path):
+    mjm, _, _, _ = test_data.fixture(path, nworld=1)
+    stepper, _ = self._compare(mjm)
+    self.assertTrue(stepper.split)
+
+  def test_matches_step_fixed_chunk(self):
+    mjm, _, _, _ = test_data.fixture("humanoid/humanoid.xml", nworld=1)
+    stepper, _ = self._compare(mjm, chunk=4)
+    self.assertTrue(stepper.split)
+    self.assertEqual(stepper.last_iterations % 4, 0)
+
+  @parameterized.parameters("humanoid/humanoid.xml", "humanoid/n_humanoid.xml")
+  def test_matches_step_sleep(self, path):
+    """Sleep routes every solve through the compact solver; n_humanoid also has enough
+    kinematic trees to exercise the island mapping."""
+    mjm, _, _, _ = test_data.fixture(path, nworld=1)
+    mjm.opt.enableflags |= mujoco.mjtEnableBit.mjENBL_SLEEP
+    stepper, _ = self._compare(mjm, nvmax=mjm.nv)
+    self.assertTrue(stepper.split)
+
+  @parameterized.parameters(mujoco.mjtIntegrator.mjINT_IMPLICITFAST, mujoco.mjtIntegrator.mjINT_EULER)
+  def test_matches_step_integrator(self, integrator):
+    mjm, _, _, _ = test_data.fixture("humanoid/humanoid.xml", nworld=1)
+    mjm.opt.integrator = integrator
+    stepper, _ = self._compare(mjm)
+    self.assertTrue(stepper.split)
+
+  def test_early_exit(self):
+    """The loop must stop just after convergence rather than replaying the whole budget."""
+    mjm, _, _, _ = test_data.fixture("humanoid/humanoid.xml", nworld=1)
+    mjm.opt.iterations = 100
+    stepper, d = self._compare(mjm)
+    niter = max(int(d.solver_niter.numpy().max()), 1)
+    self.assertGreaterEqual(stepper.last_iterations, niter)
+    # the doubling schedule overshoots convergence by at most one batch
+    self.assertLess(stepper.last_iterations, 2 * niter + 2)
+
+  # -- fallbacks --------------------------------------------------------------------
+
+  def test_fallback_rk4(self):
+    """RK4 runs four solver loops per step, so it takes the monolithic path."""
+    mjm, _, _, _ = test_data.fixture("humanoid/humanoid.xml", nworld=1)
+    mjm.opt.integrator = mujoco.mjtIntegrator.mjINT_RK4
+    stepper, _ = self._compare(mjm, split=None)
+    self.assertFalse(stepper.split)
+    self.assertIn("RK4", stepper.reason)
+    with self.assertRaises(RuntimeError):
+      mjw.Stepper(_unrolled(mjw.put_model(mjm)), mjw.put_data(mjm, mujoco.MjData(mjm), nworld=2), split=True)
+
+  def test_fallback_single_iteration(self):
+    mjm, _, _, _ = test_data.fixture("humanoid/humanoid.xml", nworld=1)
+    mjm.opt.iterations = 1
+    stepper, _ = self._compare(mjm, split=None)
+    self.assertFalse(stepper.split)
+
+  def test_fallback_conditional_graph(self):
+    """With conditional graph nodes the loop already exits at convergence in the graph."""
+    if not wp.is_conditional_graph_supported():
+      self.skipTest("device has no conditional graph nodes")
+    mjm, _, m, d = test_data.fixture("humanoid/humanoid.xml", nworld=2)
+    self.assertTrue(m.opt.graph_conditional)
+    stepper = mjw.Stepper(m, d)
+    self.assertFalse(stepper.split)
+    self.assertIn("conditional", stepper.reason)
+
+  def test_fallback_cold_data(self):
+    """A Data that has never stepped cannot supply a host-readable convergence counter."""
+    mjm, mjd, _, _ = test_data.fixture("humanoid/humanoid.xml", nworld=1)
+    m = _unrolled(mjw.put_model(mjm))
+    d = mjw.put_data(mjm, mjd, nworld=2)
+    stepper = mjw.Stepper(m, d, warmup=0)
+    self.assertFalse(stepper.split)
+    self.assertIn("stepped", stepper.reason)
+    # the fallback graph must still be a working step
+    before = d.time.numpy().copy()
+    stepper.step()
+    wp.synchronize_device()
+    np.testing.assert_allclose(d.time.numpy(), before + mjm.opt.timestep, rtol=1e-6)
+
+  def test_warmup_advances_data(self):
+    mjm, mjd, _, _ = test_data.fixture("humanoid/humanoid.xml", nworld=1)
+    m = _unrolled(mjw.put_model(mjm))
+    d = mjw.put_data(mjm, mjd, nworld=2)
+    stepper = mjw.Stepper(m, d, warmup=3)
+    np.testing.assert_allclose(d.time.numpy(), 3 * mjm.opt.timestep, rtol=1e-6)
+    self.assertTrue(stepper.split)
+
+
+if __name__ == "__main__":
+  wp.init()
+  absltest.main()
