+# limitations under the License.
+# ==============================================================================
+"""Graph-captured stepping with a host-driven solver loop.
+
+``step()`` is captured into a single graph on most platforms. Where conditional graph
+nodes exist, the solver's iteration loop becomes a conditional node that exits as soon as
+every world has converged. Where they do not (HIP/ROCm, and the JAX path), the loop is
+unrolled to the model's full iteration budget and every step replays the whole budget.
+Scenes that budget 100 iterations and converge in 1 therefore replay ~99 iterations of
+dead work per step.
+
+:class:`Stepper` recovers that. It captures the step as three graphs -- everything before
+the solver loop, one batch of solver iterations, and everything after -- and drives the
+middle one from the host, reading the solver's ``nsolving`` counter (the number of worlds
+still converging) between batches and stopping when it hits zero. The cost is one small
+device-to-host read per batch; the saving is the rest of the iteration budget.
+
+The split is produced by recording a real ``step()`` under capture, not by re-deriving
+what a step does, so it stays faithful to whatever ``step()`` actually runs (sleep,
+islands, the compact solve, control callbacks, any integrator). Where the split does not
+apply -- conditional graph nodes available, RK4, no solver loop, more than one solver loop
+per step -- the stepper falls back to capturing ``step()`` as one graph, which is exactly
+what a caller would have written by hand.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import warnings
+
+import warp as wp
+
+from mujoco_warp._src import forward
+from mujoco_warp._src import solver
+from mujoco_warp._src import types
+from mujoco_warp._src.warp_util import scratch_snapshot
+
+__all__ = ["Stepper"]
+
+# Largest batch of solver iterations that gets its own captured graph. The batch sizes are
+# powers of two up to this value; the step doubles the batch each time it has to go round
+# again, so a solve that needs n iterations costs O(log n) host reads.
+_MAX_CHUNK = 32
+
+
+class _Unsupported(Exception):
+  """Raised while inspecting a model whose step cannot be split."""
+
+
+def _cache_snapshot(d):
+  """Snapshot the lazily built caches that live on Data as non-field attributes.
+
+  A recorded step that turns out not to be splittable has to be thrown away, and with it
+  anything it allocated. Those allocations landed in the caches (solver context, collision
+  context, per-step scratch) and belong to a graph that no longer exists, so the caches
+  have to be rolled back before anything else runs.
+  """
+  fields = {f.name for f in dataclasses.fields(d)}
+  extras = {k: v for k, v in vars(d).items() if k not in fields}
+  scratch = extras.get("_scratch_arrays")
+  return fields, extras, dict(scratch) if scratch is not None else None
+
+
+def _cache_restore(d, snapshot):
+  fields, extras, scratch = snapshot
+  for key in [k for k in vars(d) if k not in fields]:
+    if key in extras:
+      setattr(d, key, extras[key])
+    else:
+      delattr(d, key)
+  if scratch is not None:
+    # Restore in place: the compact solve holds a reference to this same dict.
+    cache = d._scratch_arrays
+    cache.clear()
+    cache.update(scratch)
+
+
+class _SplitRecorder:
+  """Iteration driver that cuts the capture in two at the solver loop.
+
+  Installed as ``solver._iteration_driver`` for the duration of one recorded ``step()``.
+  When ``step()`` reaches the solver's iteration loop this ends the in-progress capture
+  (that becomes the "pre" graph), captures one batch of iterations on its own, and opens a
+  fresh capture for the remainder of the step (the "post" graph).
+  """
+
+  def __init__(self, device, chunk: int):
+    self.device = device
+    self.chunk = chunk
+    self.calls = 0
+    self.pre = None
+    self.chunk_graph = None
+    self.args = None
+
+  def __call__(self, m, d, ctx, nsolving, compact: bool = False):
+    self.calls += 1
+    if self.calls > 1:
+      # A step with more than one solver loop (RK4 runs four) cannot be expressed as
+      # pre/chunk/post. Emit the remaining loops normally so the capture stays valid and
+      # well-formed; the caller checks ``calls`` afterwards and discards the result.
+      solver.emit_solver_iterations(m, d, ctx, nsolving, compact=compact)
+      return
+
+    self.args = (m, d, ctx, nsolving, compact)
+    self.pre = wp.capture_end(device=self.device)
+
+    wp.capture_begin(device=self.device)
+    for _ in range(self.chunk):
+      solver._solver_iteration(m, d, ctx, nsolving, compact=compact)
+    self.chunk_graph = wp.capture_end(device=self.device)
+
+    wp.capture_begin(device=self.device)
+
+
+class Stepper:
+  """A graph-captured ``step()`` that stops solving once every world has converged.
+
+  Construction captures the graphs, which requires that the step's lazily allocated
+  buffers already exist -- otherwise they are allocated inside the capture, become graph
+  allocations, and are neither host-readable nor valid across graphs. ``warmup`` steps are
+  run first to force those allocations, so **constructing a Stepper advances** ``d`` **by**
+  ``warmup`` **steps**. Pass ``warmup=0`` if the Data has already been stepped.
+
+  If the preconditions for splitting are not met the stepper captures ``step()`` as a
+  single graph and behaves exactly like hand-written capture-and-replay; :attr:`split`
+  reports which it did and :attr:`reason` says why.
+
+  Args:
+    m: Model.
+    d: Data. Advanced by ``warmup`` steps during construction.
+    chunk: Fixed number of solver iterations per batch, or ``None`` (default) to use an
+      adaptive schedule that starts from the previous step's iteration count and doubles.
+    warmup: Number of steps to run before capturing, to force lazy allocations.
+    split: ``True`` to require the split (raising if it is not available), ``False`` to
+      force a single monolithic graph, or ``None`` (default) to choose automatically.
+  """
+
+  def __init__(
+    self,
+    m: types.Model,
+    d: types.Data,
+    chunk: int | None = None,
+    warmup: int = 3,
+    split: bool | None = None,
+  ):
+    self.m = m
+    self.d = d
+    self.device = wp.get_device()
+    self.split = False
+    self.reason = ""
+    self.graph = None
+    self.iterations = int(m.opt.iterations)
+    self.last_iterations = 0
+    self.last_reads = 0
+    self._chunk_graphs = {}
+    self._sizes = [1]
+    self._hint = 1
+
+    for _ in range(warmup):
+      forward.step(m, d)
+    if warmup:
+      wp.synchronize_device()
+
+    if split is not False:
+      try:
+        self._check_supported(m, d, forced=bool(split))
+        self._record_split(m, d, chunk)
+        self.split = True
+      except _Unsupported as e:
+        self.reason = str(e)
+        if split:
+          raise RuntimeError(f"Stepper cannot split this step: {e}") from None
+
+    if not self.split:
+      with wp.ScopedCapture(device=self.device) as cap:
+        forward.step(m, d)
+      self.graph = cap.graph
+
+  # -- setup ------------------------------------------------------------------------
+
+  def _check_supported(self, m, d, forced: bool):
+    # supports_graph_capture only exists in newer Warp; assume capture works without it.
+    if not self.device.is_cuda or not getattr(self.device, "supports_graph_capture", True):
+      raise _Unsupported("device does not support graph capture")
+    if m.opt.integrator == types.IntegratorType.RK4:
+      raise _Unsupported("the RK4 integrator runs four solver loops per step")
+    if m.opt.iterations < 2:
+      raise _Unsupported(f"nothing to skip at opt.iterations={m.opt.iterations}")
+    if m.opt.graph_conditional and not forced:
+      # A conditional graph node does this in the graph, with no host round trip.
+      raise _Unsupported("conditional graph nodes already exit the solver at convergence")
+    if "solver.nsolving" not in (getattr(d, "_scratch_arrays", None) or {}):
+      # The convergence counter has to already exist, or it is allocated inside the
+      # capture: a graph allocation, valid only while that graph runs, so neither
+      # host-readable nor usable by the next graph. Checked before capturing anything so
+      # a cold Data costs nothing but the fallback.
+      raise _Unsupported("Data has not been stepped, so the nsolving counter does not exist yet")
+
+  def _capture_split(self, m, d, chunk0):
+    """Record one step, cut in three at the solver loop."""
+    rec = _SplitRecorder(self.device, chunk0)
+    previous = solver._iteration_driver
+    solver._iteration_driver = rec
+    try:
+      if wp.capture_begin(device=self.device) is False:
+        raise _Unsupported("graph capture is disabled on this device")
+      try:
+        forward.step(m, d)
+        post = wp.capture_end(device=self.device)
+      except Exception:
+        self._abort_capture()
+        raise
+    finally:
+      solver._iteration_driver = previous
+
+    if rec.calls == 0:
+      raise _Unsupported("step contains no solver iteration loop")
+    if rec.calls > 1:
+      raise _Unsupported(f"step contains {rec.calls} solver loops")
+    return (*rec.args, rec.pre, rec.chunk_graph, post)
+
+  def _record_split(self, m, d, chunk):
+    chunk0 = 1 if chunk is None else int(chunk)
+    if chunk0 < 1:
+      raise _Unsupported(f"chunk must be at least 1, got {chunk0}")
+
+    snapshot = _cache_snapshot(d)
+    before = scratch_snapshot(d)
+    try:
+      m_s, d_s, ctx, nsolving, compact, pre, chunk_graph, post = self._capture_split(m, d, chunk0)
+    except Exception:
+      _cache_restore(d, snapshot)
+      raise
+
+    if before.get("solver.nsolving", (None,))[0] != nsolving.ptr:
+      _cache_restore(d, snapshot)
+      raise _Unsupported("the nsolving counter was reallocated during capture")
+
+    self.iterations = int(m.opt.iterations)
+    self.nsolving = nsolving
+    self.graph_pre = pre
+    self.graph_post = post
+    self._chunk_graphs = {chunk0: chunk_graph}
+
+    if chunk is None:
+      self._sizes = [1]
+      size = 2
+      while size <= min(_MAX_CHUNK, self.iterations):
+        self._sizes.append(size)
+        size *= 2
+      for size in self._sizes:
+        if size not in self._chunk_graphs:
+          with wp.ScopedCapture(device=self.device) as cap:
+            for _ in range(size):
+              solver._solver_iteration(m_s, d_s, ctx, nsolving, compact=compact)
+          self._chunk_graphs[size] = cap.graph
+    else:
+      self._sizes = [chunk0]
+
+    fresh = [k for k, v in scratch_snapshot(d).items() if before.get(k) != v]
+    if fresh:
+      warnings.warn(
+        f"Stepper captured {len(fresh)} allocation(s) ({', '.join(sorted(fresh)[:4])}); "
+        "step the Data a few more times before constructing the Stepper for allocation-free graphs.",
+        stacklevel=3,
+      )
+
+  def _abort_capture(self):
+    """Close any capture the recorder left open, so a failure does not strand the stream."""
+    for _ in range(3):
+      try:
+        wp.capture_end(device=self.device)
+      except Exception:
+        return
+
+  # -- stepping ---------------------------------------------------------------------
+
+  def step(self):
+    """Advance the simulation by one step. Equivalent to ``mjw.step(m, d)``."""
+    if not self.split:
+      wp.capture_launch(self.graph)
+      return
+
+    wp.capture_launch(self.graph_pre)
+
+    budget = self.iterations
+    done = 0
+    reads = 0
+    launches = 0
+    # Start from the batch size that covered the previous step, so a scene with a stable
+    # iteration count settles on one host read per step.
+    size = self._pick(self._hint, budget)
+    while True:
+      wp.capture_launch(self._chunk_graphs[size])
+      launches += 1
+      done += size
+      if done >= budget:
+        # The budget is spent, so the solver is finished either way and there is nothing
+        # left to skip. Break without paying for the read.
+        break
+      reads += 1
+      # Implicit device sync. Iterations past convergence are no-ops (every solver kernel
+      # returns early for a world that is done), so a batch that runs past convergence
+      # only costs replay time, never accuracy.
+      if int(self.nsolving.numpy()[0]) == 0:
+        break
+      size = self._pick(2 * size, budget - done)
+    # Finishing inside the first batch says the batch was big enough but not how much
+    # smaller it could be, so halve it and let the doubling grow it back if that was too
+    # far. Converging steadily in one iteration then costs one iteration, not a stale
+    # oversized batch.
+    self._hint = max(1, (self._hint + 1) // 2) if launches == 1 else done
+    self.last_iterations = done
+    self.last_reads = reads
+
+    wp.capture_launch(self.graph_post)
+
+  def _pick(self, want: int, remaining: int) -> int:
+    """The largest captured batch size that is neither above ``want`` nor overshoots the
+    remaining budget by a whole batch."""
+    cap = min(want, max(remaining, 1), self._sizes[-1])
+    return max([s for s in self._sizes if s <= cap] or [self._sizes[0]])
+
+  __call__ = step
