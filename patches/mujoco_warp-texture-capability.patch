+  # Devices without image/texture hardware (e.g. AMD CDNA compute GPUs) cannot
+  # create textures; render untextured there. Texture sampling is compiled out
+  # via wp.static(use_textures) so an empty registry is safe.
+  if use_textures and not getattr(wp.get_device(), "is_texture_supported", True):
+    warnings.warn("Device has no texture hardware support; rendering with textures disabled.")
+    use_textures = False
+
   textures_registry = []
-  for i in range(mjm.ntex):
-    textures_registry.append(render_util.create_warp_texture(mjm, i))
+  if use_textures:
+    for i in range(mjm.ntex):
+      textures_registry.append(render_util.create_warp_texture(mjm, i))
   textures = wp.array(textures_registry, dtype=wp.Texture2D)
 
   # Locate skybox texture
   skybox_tex_ids = np.nonzero(mjm.tex_type == mujoco.mjtTexture.mjTEXTURE_SKYBOX)[0] if mjm.ntex else np.array([], dtype=int)
-  if render_skybox and skybox_tex_ids.size > 0:
+  if use_textures and render_skybox and skybox_tex_ids.size > 0:
     skybox_tex_id_np = np.array([skybox_tex_ids[0]], dtype=int)
     skybox_face_width_np = np.array([mjm.tex_width[skybox_tex_ids[0]]], dtype=int)
   else:
